{
	"name": "df_silver_incidente_ruta",
	"properties": {
		"folder": {
			"name": "df_silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_incidente_ruta_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_incidente_ruta_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "split1"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          RutaHistoricaId as string,",
				"          EsPrincipal as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(IncidenteId = upper(trim(IncidenteId)),",
				"          RutaHistoricaId = upper(trim(RutaHistoricaId)),",
				"          EsPrincipal = trim(EsPrincipal)) ~> derivedColumn1",
				"derivedColumn1 derive(EsPrincipal = iif(EsPrincipal == '1' || upper(EsPrincipal) == 'TRUE', true(), false())) ~> derivedColumn2",
				"derivedColumn2 split(!isNull(IncidenteId) && !isNull(RutaHistoricaId) && !isNull(EsPrincipal),",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos aggregate(groupBy(IncidenteId,",
				"          RutaHistoricaId),",
				"     EsPrincipal = first(EsPrincipal)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          IncidenteId as string,",
				"          RutaHistoricaId as string,",
				"          EsPrincipal as boolean",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          IncidenteId,",
				"          RutaHistoricaId,",
				"          EsPrincipal",
				"     )) ~> sink1"
			]
		}
	}
}