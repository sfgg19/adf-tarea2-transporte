{
	"name": "df_silver_incidentes",
	"properties": {
		"folder": {
			"name": "df_silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "split1"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as string,",
				"          FechaHoraFin as string,",
				"          FechaHoraRegistro as string,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(IncidenteId = upper(trim(IncidenteId)),",
				"          TipoIncidente = upper(trim(toString(TipoIncidente))),",
				"          Severidad = upper(trim(toString(Severidad))),",
				"          FechaHoraInicio = iif(regexMatch(trim(toString(FechaHoraInicio)), '^\\\\d{2}/\\\\d{2}/\\\\d{4}'), concat(toString(toDate(left(trim(toString(FechaHoraInicio)), 10), 'dd/MM/yyyy'), 'yyyy-MM-dd'), substring(trim(toString(FechaHoraInicio)), 11, length(trim(toString(FechaHoraInicio))))), trim(toString(FechaHoraInicio))),",
				"          FechaHoraFin = iif(regexMatch(trim(toString(FechaHoraFin)), '^\\\\d{2}/\\\\d{2}/\\\\d{4}'), concat(toString(toDate(left(trim(toString(FechaHoraFin)), 10), 'dd/MM/yyyy'), 'yyyy-MM-dd'), substring(trim(toString(FechaHoraFin)), 11, length(trim(toString(FechaHoraFin))))), trim(toString(FechaHoraFin))),",
				"          FechaHoraRegistro = iif(regexMatch(trim(toString(FechaHoraRegistro)), '^\\\\d{2}/\\\\d{2}/\\\\d{4}'), concat(toString(toDate(left(trim(toString(FechaHoraRegistro)), 10), 'dd/MM/yyyy'), 'yyyy-MM-dd'), substring(trim(toString(FechaHoraRegistro)), 11, length(trim(toString(FechaHoraRegistro))))), trim(toString(FechaHoraRegistro))),",
				"          VehiculoId = iif(isNull(VehiculoId) || length(trim(VehiculoId)) == 0, toString(null()), 'V-' + lpad(regexReplace(upper(trim(VehiculoId)), '[^0-9]', ''), 3, '0')),",
				"          Descripcion = trim(toString(Descripcion))) ~> derivedColumn1",
				"derivedColumn1 derive(FechaHoraInicio = toTimestamp(FechaHoraInicio, 'yyyy-MM-dd HH:mm:ss'),",
				"          FechaHoraFin = toTimestamp(FechaHoraFin, 'yyyy-MM-dd HH:mm:ss'),",
				"          FechaHoraRegistro = toTimestamp(FechaHoraRegistro, 'yyyy-MM-dd HH:mm:ss')) ~> derivedColumn2",
				"derivedColumn2 split(!isNull(IncidenteId) && !isNull(TipoIncidente) && !isNull(Severidad) && !isNull(FechaHoraInicio) && !isNull(FechaHoraFin) && !isNull(FechaHoraRegistro) && !isNull(Descripcion),",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos aggregate(groupBy(IncidenteId),",
				"     TipoIncidente = first(TipoIncidente),",
				"          Severidad = first(Severidad),",
				"          FechaHoraInicio = first(FechaHoraInicio),",
				"          FechaHoraFin = first(FechaHoraFin),",
				"          FechaHoraRegistro = first(FechaHoraRegistro),",
				"          VehiculoId = first(VehiculoId),",
				"          Descripcion = first(Descripcion)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as timestamp,",
				"          FechaHoraFin as timestamp,",
				"          FechaHoraRegistro as timestamp,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          IncidenteId,",
				"          TipoIncidente,",
				"          Severidad,",
				"          FechaHoraInicio,",
				"          FechaHoraFin,",
				"          FechaHoraRegistro,",
				"          VehiculoId,",
				"          Descripcion",
				"     )) ~> sink1"
			]
		}
	}
}