{
	"name": "df_silver_paradas",
	"properties": {
		"folder": {
			"name": "df_silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "split1"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ParadaHistoricaId as string,",
				"          CodigoPublicado as string,",
				"          NombreParada as string,",
				"          Zona as string,",
				"          Latitud as string,",
				"          Longitud as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(ParadaHistoricaId = upper(trim(ParadaHistoricaId)),",
				"          CodigoPublicado = upper(trim(CodigoPublicado)),",
				"          NombreParada = trim(toString(NombreParada)),",
				"          Zona = trim(toString(Zona)),",
				"          Latitud = replace(trim(toString(Latitud)), ',', '.'),",
				"          Longitud = replace(trim(toString(Longitud)), ',', '.'),",
				"          VigenciaDesde = iif(regexMatch(trim(toString(VigenciaDesde)), '^\\\\d{2}/\\\\d{2}/\\\\d{4}$'), toString(toDate(trim(toString(VigenciaDesde)), 'dd/MM/yyyy'), 'yyyy-MM-dd'), trim(toString(VigenciaDesde))),",
				"          VigenciaHasta = iif(regexMatch(trim(toString(VigenciaHasta)), '^\\\\d{2}/\\\\d{2}/\\\\d{4}$'), toString(toDate(trim(toString(VigenciaHasta)), 'dd/MM/yyyy'), 'yyyy-MM-dd'), trim(toString(VigenciaHasta))),",
				"          Estado = upper(trim(toString(Estado)))) ~> derivedColumn1",
				"derivedColumn1 derive(Latitud = toDecimal(Latitud, 9, 6),",
				"          Longitud = toDecimal(Longitud, 9, 6),",
				"          VigenciaDesde = toDate(VigenciaDesde, 'yyyy-MM-dd'),",
				"          VigenciaHasta = toDate(VigenciaHasta, 'yyyy-MM-dd')) ~> derivedColumn2",
				"derivedColumn2 split(!isNull(ParadaHistoricaId) && !isNull(CodigoPublicado) && !isNull(NombreParada) && !isNull(Zona) && !isNull(Latitud) && !isNull(Longitud) && !isNull(VigenciaDesde) && !isNull(VigenciaHasta) && !isNull(Estado),",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos aggregate(groupBy(ParadaHistoricaId),",
				"     CodigoPublicado = first(CodigoPublicado),",
				"          NombreParada = first(NombreParada),",
				"          Zona = first(Zona),",
				"          Latitud = first(Latitud),",
				"          Longitud = first(Longitud),",
				"          VigenciaDesde = first(VigenciaDesde),",
				"          VigenciaHasta = first(VigenciaHasta),",
				"          Estado = first(Estado)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ParadaHistoricaId as string,",
				"          CodigoPublicado as string,",
				"          NombreParada as string,",
				"          Zona as string,",
				"          Latitud as decimal(9,6),",
				"          Longitud as decimal(9,6),",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          ParadaHistoricaId,",
				"          CodigoPublicado,",
				"          NombreParada,",
				"          Zona,",
				"          Latitud,",
				"          Longitud,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     )) ~> sink1"
			]
		}
	}
}